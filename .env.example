# All values are optional. The service runs fully offline with the defaults.
PORT=3000
# If set, POST /webhook/lead must send this value in the x-webhook-secret header.
WEBHOOK_SECRET=
# Target time from receipt to first response, in seconds.
SLA_SECONDS=60
# A second lead with the same phone or email inside this window is a duplicate.
DEDUPE_WINDOW_MINUTES=1440
# Only "mock" is implemented. The mock channel records messages in memory.
CHANNEL_MODE=mock
# Simulated delivery latency of the mock channel, in milliseconds.
MOCK_CHANNEL_LATENCY_MS=150
